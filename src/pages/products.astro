---
import BaseLayout from "../layouts/BaseLayout.astro";
import { companyInfo } from "../data/company";
import { products } from "../data/products";

interface PaginationItem {
  label: string;
  href: string;
  active?: boolean;
  icon?: string;
}

const whatsappNumber = companyInfo.whatsapp.replace(/\D/g, "");

const getProductWhatsappUrl = (productName: string) => {
  const message = encodeURIComponent(
    `Hello ${companyInfo.name}, I would like to enquire about ${productName}. Please share the details.`,
  );

  return `https://wa.me/${whatsappNumber}?text=${message}`;
};

const pagination: PaginationItem[] = [
  { label: "01", href: "/products/", active: true },
  { label: "02", href: "/products/?page=2" },
  { label: "03", href: "/products/?page=3" },
  { label: "next", href: "/products/?page=2", icon: "ri-arrow-right-line" },
];

const productSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${companyInfo.name} Products`,
  description:
    "Browse construction tools, accessories, and equipment on the Engineers Interlocks product page.",
  url: new URL("/products/", companyInfo.website).href,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: products.map((product, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Product",
        name: product.name,
        image: new URL(product.image, companyInfo.website).href,
      },
    })),
  },
};
---

<BaseLayout
  title={`${companyInfo.name} | Products`}
  description="Explore the Engineers Interlocks product catalog, featuring premium interlocks, designer tiles, and  hollow bricks crafted for durable and visually refined outdoor spaces."
  canonical="/products/"
  schema={productSchema}
>
  {
    products.map((product, index) => (
      <div id={`QuickView-${index}`} class="white-popup mfp-hide">
        <div class="container bg-white">
          <div class="row gx-60">
            <div class="col-lg-6">
              <div class="product-big-img">
                <div class="img">
                  <img
                    src={product.image}
                    alt={product.name}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
            </div>
            <div class="col-lg-6 align-self-center">
              <div class="product-about">
                <h2 class="product-title">{product.name}</h2>
                <p class="text">
                  Explore this product from the Engineers Interlocks catalog.
                  Contact us for specifications, availability, and project
                  support.
                </p>
                <div class="actions">
                  <a
                    class="btn"
                    href={getProductWhatsappUrl(product.name)}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Request Details
                  </a>
                </div>
              </div>
            </div>
          </div>
          <button title="Close (Esc)" type="button" class="mfp-close"
            >&times;</button
          >
        </div>
      </div>
    ))
  }

  <div
    class="breadcumb-wrapper"
    data-bg-src="/assets/img/bg/breadcrumb-bg.jpeg"
  >
    <div
      class="section-animation-shape1-1 shape-mockup animation-infinite"
      data-top="0"
      data-bg-src="/assets/img/shape/global-line-shape1.png"
    >
    </div>
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="breadcumb-content">
            <h1 class="breadcumb-title">Products</h1>
            <ul class="breadcumb-menu">
              <li><a href="/"><i class="ri-home-4-fill"></i> HOME</a></li>
              <li class="active">PRODUCTS</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="space-top space-extra-bottom">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-12">
          <div class="row gy-40">
            {
              products.map((product, index) => (
                <div class="col-xl-4 col-md-6">
                  <div class="product-card">
                    <div class="product-img">
                      <img
                        src={product.image}
                        alt={product.name}
                        loading="lazy"
                        decoding="async"
                      />
                    <div class="actions">
                        <a
                          href={`#QuickView-${index}`}
                          class="icon-btn popup-content"
                          aria-label={`Quick view ${product.name}`}
                        >
                          <i class="ri-eye-line" />
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>

          <div class="pagination justify-content-center">
            <ul>
              {
                pagination.map((item) => (
                  <li>
                    <a
                      class:list={{ active: item.active }}
                      href={item.href}
                      aria-current={item.active ? "page" : undefined}
                    >
                      {item.icon ? <i class={item.icon} /> : item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .product-card .product-img {
      padding: 0;
      margin-bottom: 0;
      text-align: left;
    }

    .product-card .product-img img {
      display: block;
      width: 100%;
      transform: none;
      object-fit: cover;
    }
  </style>
</BaseLayout>
