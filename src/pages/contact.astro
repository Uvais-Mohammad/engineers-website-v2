---
import { companyInfo, companyLocations } from '../data/company';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={`${companyInfo.name} | Contact`}
  description="Contact Engineers Interlocks for premium interlocks, designer tiles, and hollow bricks in Kerala. Visit our branches, call us, or request a quote for your project."
  canonical="/contact/"
>
  <div class="breadcumb-wrapper" data-bg-src="/assets/img/bg/breadcrumb-bg.png">
    <div
      class="section-animation-shape1-1 shape-mockup animation-infinite"
      data-top="0"
      data-bg-src="/assets/img/shape/global-line-shape1.png"
    >
    </div>
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="breadcumb-content">
            <h1 class="breadcumb-title">Contact Us</h1>
            <ul class="breadcumb-menu">
              <li><a href="/"><i class="ri-home-4-fill"></i> HOME</a></li>
              <li class="active">CONTACT US</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="contact-page-area space">
    <div class="container">
      <div class="row gy-4 justify-content-center">
        {companyLocations.map((location) => (
          <div class="col-md-6 col-lg-6">
            <div class="contact-page-card bg-smoke">
              <span class="contact-page-card_label">{location.label}</span>
              <div class="contact-page-card-details">
                <h4 class="contact-page-card_title">{location.name}</h4>
                {location.addressLines.map((line) => (
                  <div class="contact-page-card-text">
                    <i class="ri-map-pin-line"></i>
                    <span>{line}</span>
                  </div>
                ))}
                {location.phone && location.phoneHref && (
                  <div class="contact-page-card-text">
                    <i class="ri-phone-line"></i>
                    <a class="contact-page-card_link" href={`tel:${location.phoneHref}`}>{location.phone}</a>
                  </div>
                )}
                <div class="contact-page-card-text">
                  <i class="ri-mail-line"></i>
                  <a class="contact-page-card_link" href={`mailto:${companyInfo.email}`}>{companyInfo.email}</a>
                </div>
              </div>
              <div class="contact-page-card-thumb">
                <iframe
                  src={location.media.src}
                  title={location.media.title}
                  loading="lazy"
                  allowfullscreen
                  referrerpolicy="no-referrer-when-downgrade"
                ></iframe>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="contact-area-2 space-bottom overflow-hidden">
    <div class="container">
      <div class="contact-wrap2 space overflow-hidden" data-bg-src="/assets/img/bg/contact-bg3-1.png">
        <div
          class="section-animation-shape1-1 shape-mockup animation-infinite"
          data-top="0"
          data-left="0"
          data-bg-src="/assets/img/shape/global-line-shape1.png"
        >
        </div>
        <div class="row gy-60 justify-content-lg-end justify-content-center">
          <div class="col-xl-7">
            <div class="contact-form-wrap">
              <div class="title-area">
                <span class="sub-title text-theme">
                  <img src="/assets/img/icon/section-subtitle-icon.svg" alt="img" loading="lazy" decoding="async" />
                  Get Free Quote
                </span>
                <h2 class="sec-title">Have a project in mind?</h2>
              </div>
              <form action={`https://formsubmit.co/61c0bacca2b4fc9f2f41db37ed16e37d`} method="POST" class="contact-form">
                <input type="hidden" name="_subject" value={`New contact form submission | ${companyInfo.name}`} />
                <input type="hidden" name="_captcha" value="false" />
                <input type="hidden" name="_template" value="table" />
                <div class="row gy-4">
                  <div class="col-md-6">
                    <div class="form-group">
                      <input type="text" class="form-control" name="name" id="name" placeholder="Your Name" />
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group">
                      <input type="email" class="form-control" name="email" id="email" placeholder="Email Address" />
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group">
                      <input type="tel" class="form-control" name="number" id="number" placeholder="Phone Number" />
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group">
                      <select name="subject" id="subject" class="single-select nice-select form-select">
                        <option value="" disabled selected hidden>Your Inquiry</option>
                        <option value="Interlocks">Interlocks</option>
                        <option value="Designer Tiles">Designer Tiles</option>
                        <option value="Hollow Bricks">Hollow Bricks</option>
                      </select>
                    </div>
                  </div>

                  <div class="col-12">
                    <div class="form-group ">
                      <textarea name="message" id="message" cols="30" rows="3" class="form-control" placeholder="Message..."></textarea>
                    </div>
                  </div>
                  <div class="form-btn col-12">
                    <button class="btn w-100">Submit Now <i class="ri-arrow-right-up-line"></i></button>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .contact-page-card .contact-page-card_label {
      position: absolute;
      top: 22px;
      left: auto;
      right: 22px !important;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      padding: 7px 14px;
      border-radius: 999px;
      background: var(--theme-color);
      color: var(--white-color);
      box-shadow: 0 10px 24px rgba(217, 37, 39, 0.22);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .contact-page-card {
      position: relative;
      overflow: hidden;
      border: 1px solid var(--theme-color);
      transition:
        transform 0.35s ease,
        box-shadow 0.35s ease,
        border-color 0.35s ease;
    }

    .contact-page-card::before {
      content: '';
      position: absolute;
      inset: -35%;
      background: linear-gradient(
        120deg,
        transparent 35%,
        rgba(255, 255, 255, 0.3) 50%,
        transparent 65%
      );
      transform: translateX(-140%) rotate(8deg);
      transition: transform 0.6s ease;
      pointer-events: none;
    }

    .contact-page-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
    }

    .contact-page-card:hover::before {
      transform: translateX(140%) rotate(8deg);
    }

    .contact-page-card .contact-page-card-thumb {
      margin-top: 40px;
    }

    .contact-page-card .contact-page-card-thumb iframe {
      height: 300px;
    }

    @media (max-width: 575px) {
      .contact-page-card .contact-page-card_label {
        top: 18px;
        left: auto;
        right: 18px !important;
        padding: 6px 12px;
        font-size: 11px;
      }

    }
  </style>

</BaseLayout>
