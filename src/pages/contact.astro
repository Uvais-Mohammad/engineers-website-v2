---
import { companyInfo, companyLocations } from '../data/company';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`${companyInfo.name} | Contact`} description="Contact page with office details and reusable lead form component." canonical="/contact/">
  <div class="breadcumb-wrapper" data-bg-src="/assets/img/bg/breadcrumb-bg.png">
    <div
      class="section-animation-shape1-1 shape-mockup animation-infinite"
      data-top="0"
      data-bg-src="/assets/img/shape/global-line-shape1.png"
    >
    </div>
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="breadcumb-content">
            <h1 class="breadcumb-title">Contact Us</h1>
            <ul class="breadcumb-menu">
              <li><a href="/"><i class="ri-home-4-fill"></i> HOME</a></li>
              <li class="active">CONTACT US</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="contact-page-area space">
    <div class="container">
      <div class="row gy-4 justify-content-center">
        {companyLocations.map((location) => (
          <div class="col-md-6 col-lg-6">
            <div class="contact-page-card bg-smoke">
              <div class="contact-page-card-details">
                <h4 class="contact-page-card_title">{location.name}</h4>
                {location.addressLines.map((line) => (
                  <div class="contact-page-card-text">
                    <i class="ri-map-pin-line"></i>
                    <span>{line}</span>
                  </div>
                ))}
                {location.phone && location.phoneHref && (
                  <div class="contact-page-card-text">
                    <i class="ri-phone-line"></i>
                    <a class="contact-page-card_link" href={`tel:${location.phoneHref}`}>{location.phone}</a>
                  </div>
                )}
                <div class="contact-page-card-text">
                  <i class="ri-mail-line"></i>
                  <a class="contact-page-card_link" href={`mailto:${companyInfo.email}`}>{companyInfo.email}</a>
                </div>
              </div>
              <div class="contact-page-card-thumb">
                {location.media.type === 'map' ? (
                  <iframe
                    src={location.media.src}
                    title={location.media.title}
                    loading="lazy"
                    allowfullscreen
                    referrerpolicy="no-referrer-when-downgrade"
                  ></iframe>
                ) : (
                  <img src={location.media.src} alt={location.media.alt} loading="lazy" decoding="async" />
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="contact-area-2 space-bottom overflow-hidden">
    <div class="container">
      <div class="contact-wrap2 space overflow-hidden" data-bg-src="/assets/img/bg/contact-bg3-1.png">
        <div
          class="section-animation-shape1-1 shape-mockup animation-infinite"
          data-top="0"
          data-left="0"
          data-bg-src="/assets/img/shape/global-line-shape1.png"
        >
        </div>
        <div class="row gy-60 justify-content-lg-end justify-content-center">
          <div class="col-xl-7">
            <div class="contact-form-wrap">
              <div class="title-area">
                <span class="sub-title text-theme">
                  <img src="/assets/img/icon/section-subtitle-icon.svg" alt="img" loading="lazy" decoding="async" />
                  Get Free Quote
                </span>
                <h2 class="sec-title">Have a project in mind?</h2>
              </div>
              <form action="#" method="POST" class="contact-form ajax-contact">
                <div class="row gy-4">
                  <div class="col-md-6">
                    <div class="form-group">
                      <input type="text" class="form-control" name="name" id="name" placeholder="Your Name" />
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group">
                      <input type="email" class="form-control" name="email" id="email" placeholder="Email Address" />
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group">
                      <input type="tel" class="form-control" name="number" id="number" placeholder="Phone Number" />
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group">
                      <select name="subject" id="subject" class="single-select nice-select form-select">
                        <option value="" disabled selected hidden>Your Inquiry</option>
                        <option value="Web Design">Web Design</option>
                        <option value="Web Development">Web Development</option>
                        <option value="Engine Diagnostics">Engine Diagnostics</option>
                        <option value="Digital Marketing">Digital Marketing</option>
                      </select>
                    </div>
                  </div>

                  <div class="col-12">
                    <div class="form-group ">
                      <textarea name="message" id="message" cols="30" rows="3" class="form-control" placeholder="Message..."></textarea>
                    </div>
                  </div>
                  <div class="form-btn col-12">
                    <button class="btn w-100">Submit Now <i class="ri-arrow-right-up-line"></i></button>
                  </div>
                </div>
                <p class="form-messages mb-0 mt-3"></p>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="map-area overflow-hidden">
    <div class="map-sec">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3644.7310056272386!2d89.2286059153658!3d24.00527418490799!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39fe9b97badc6151%3A0x30b048c9fb2129bc!2s!5e0!3m2!1sen!2sbd!4v1651028958211!5m2!1sen!2sbd"
        title="Contact location"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>
  </div>

</BaseLayout>
