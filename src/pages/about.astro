import { companyInfo } from '../data/company';
import BaseLayout from '../layouts/BaseLayout.astro';

const toTitleCase = (value: string) =>
  value
    .split(/\s+/)
    .filter(Boolean)
    .map((word: string) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');

const parseProjectMeta = (slug: string) => {
  const match = slug.match(/^(.*)\(([^)]+)\)$/);
  const rawTitle = match ? match[1] : slug;
  const rawAddress = match ? match[2] : '';

  return {
    title: toTitleCase(rawTitle.replace(/[-_]+/g, ' ').trim()),
    address: toTitleCase(rawAddress.replace(/[-_]+/g, ' ').trim()),
  };
};

const projectFiles = [
  'asset-homes(Kannur).png',
  'calicut-trade-centre(Calicut).png',
  'confident-group(Calicut).png',
  'landmark-world(Calicut).png',
  'nayara-energy(calicut).png',
];

const recentProjects = projectFiles
  .sort((a, b) => a.localeCompare(b))
  .map((file) => {
    const slug = file.replace(/\.[^.]+$/, '');
    const projectMeta = parseProjectMeta(slug);

    return {
      title: projectMeta.title,
      address: projectMeta.address,
      src: `/assets/img/project/${file}`,
      alt: projectMeta.title,
    };
  });
