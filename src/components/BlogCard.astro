---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const day = post.data.publishDate.toLocaleDateString('en-US', { day: '2-digit' });
const month = post.data.publishDate.toLocaleDateString('en-US', { month: 'short' }).toUpperCase();
const year = post.data.publishDate.getFullYear();
---

<div class="col-md-6 col-lg-4">
  <article class="blog-card">
    <div class="blog-img">
      <Image src={post.data.cover} alt={post.data.coverAlt} />
      <div class="blog-date">
        <a href="/blog/"><span>{day}</span>{month}</a>
        <div class="year">{year}</div>
      </div>
    </div>
    <div class="blog-content">
      <div class="blog-meta">
        <a href="/blog/">By {post.data.author}</a>
        <a href={`/blog/tags/${post.data.tags[0].toLowerCase()}/`}>{post.data.tags[0]}</a>
      </div>
      <h3 class="blog-title"><a href={`/blog/${post.data.slug}/`}>{post.data.title}</a></h3>
      <p class="blog-text">{post.data.description}</p>
      <a href={`/blog/${post.data.slug}/`} class="btn">More Details <i class="ri-arrow-right-up-line"></i></a>
    </div>
  </article>
</div>
