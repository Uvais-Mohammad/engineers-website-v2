---
import { companyInfo } from '../data/company';
import { footerLinks } from '../data/navigation';

const year = new Date().getFullYear();
---

<footer class="footer-wrapper footer-layout3" data-bg-src="/assets/img/bg/footer-bg1-1.png">
  <div class="container">
    <div class="widget-area">
      <div class="row justify-content-between">
        <div class="col-md-6 col-xl-3">
          <div class="widget widget-about footer-widget">
            <h3 class="widget_title">About Company</h3>
            <p class="about-text">{companyInfo.tagline}</p>
            <h4 class="about-year">Since 2000</h4>
            <h5 class="about-subtitle">WE ARE AVAILABLE</h5>
            <p class="about-text"><span class="text-theme">Mon-Sat:</span> {companyInfo.businessHours}</p>
          </div>
        </div>
        <div class="col-md-6 col-xl-auto">
          <div class="widget widget_nav_menu footer-widget">
            <h3 class="widget_title">Useful Links</h3>
            <div class="menu-all-pages-container grid-style">
              <ul class="menu">
                {footerLinks.company.map((item) => (
                  <li><a href={item.href}>{item.label}</a></li>
                ))}
              </ul>
              <ul class="menu">
                {footerLinks.support.map((item) => (
                  <li><a href={item.href}>{item.label}</a></li>
                ))}
              </ul>
            </div>
          </div>
        </div>
        <div class="col-md-6 col-xl-auto">
          <div class="widget footer-widget widget-contact">
            <h3 class="widget_title">Office Address</h3>
            <p class="contact-text">{companyInfo.address}</p>
            <h3 class="widget_title">Email Address</h3>
            <p class="text-white footer-text">Get in Touch!</p>
            <p class="footer-text"><a href={`mailto:${companyInfo.email}`}>{companyInfo.email}</a></p>
          </div>
        </div>
        <div class="col-md-6 col-xl-auto">
          <div class="widget footer-widget">
            <h3 class="widget_title">Phone Number</h3>
            <p class="footer-text"><a href={`tel:${companyInfo.phone.replace(/\s+/g, '')}`}>{companyInfo.phone}</a></p>
            <p class="footer-text"><a href={`tel:${companyInfo.secondaryPhone.replace(/\s+/g, '')}`}>{companyInfo.secondaryPhone}</a></p>
            <h3 class="widget_title">Follow Us</h3>
            <div class="social-btn style2">
              {companyInfo.social.instagram && (
                <a href={companyInfo.social.instagram} target="_blank" rel="noreferrer">
                  <i class="ri-instagram-line"></i>
                </a>
              )}
              {companyInfo.social.facebook && (
                <a href={companyInfo.social.facebook} target="_blank" rel="noreferrer">
                  <i class="ri-facebook-fill"></i>
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="container">
    <div class="copyright-wrap">
      <div class="row gy-3 justify-content-md-between justify-content-center">
        <div class="col-auto align-self-center">
          <p class="copyright-text text-center">© {year} <a href="/">{companyInfo.name}</a> | All rights reserved</p>
        </div>
        <div class="col-auto">
          <div class="footer-links">
            <a href="/contact/">Terms & Condition</a>
            <a href="/contact/">Privacy Policy</a>
            <a href="/contact/">Contact Us</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
