---
import SiteImage from './SiteImage.astro';
import { companyInfo } from '../data/company';
import { mainNavigation } from '../data/navigation';

const currentPath = Astro.url.pathname;
---

<header class="nav-header header-layout3">
  <div class="sticky-wrapper">
    <div class="menu-area">
      <div class="container">
        <div class="row align-items-center justify-content-lg-start justify-content-between">
          <div class="col-auto">
            <div class="header-logo">
              <a href="/"><SiteImage src={companyInfo.logo} alt={companyInfo.name} priority /></a>
            </div>
          </div>
          <div class="col-auto ms-auto ms-xxl-0">
            <nav class="main-menu d-none d-lg-inline-block">
              <ul>
                {mainNavigation.map((item) => (
                  <li class:list={{ active: currentPath === item.href }}>
                    <a href={item.href}>{item.label.toUpperCase()}</a>
                  </li>
                ))}
              </ul>
            </nav>
            <div class="navbar-right d-inline-flex d-lg-none">
              <button type="button" class="menu-toggle icon-btn"><i class="ri-menu-line"></i></button>
            </div>
          </div>
          <div class="col-auto ms-auto d-xl-block d-none">
            <div class="header-button">
              <div class="navbar-right-desc">
                <div class="icon-btn">
                  <i class="ri-phone-fill"></i>
                </div>
                <div class="navbar-right-desc-details">
                  <h6 class="title">Call us any time</h6>
                  <a class="link" href={`tel:${companyInfo.phone.replace(/\s+/g, '')}`}>{companyInfo.phone}</a>
                </div>
              </div>
              <a href="/contact/" class="btn d-xxl-flex d-none">
                GET IN TOUCH <i class="ri-arrow-right-up-line"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  @media (min-width: 992px) {
    .header-layout3 .menu-area > .container {
      padding-left: 32px;
    }
  }
</style>
