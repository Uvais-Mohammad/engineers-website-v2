---
import { companyInfo } from '../../data/company';
import { testimonials } from '../../data/home';

const faqs = [
  {
    id: '1',
    question: 'Which products does Engineers Interlocks supply?',
    answer:
      'We supply premium interlocks, designer tiles, and hollow bricks for homes, landscapes, driveways, walkways, and commercial spaces across Kerala.',
    active: true,
  },
  {
    id: '2',
    question: 'Do you support custom sizes and project requirements?',
    answer:
      'Yes. We handle project-based requirements for patterns, finishes, quantities, and product selection so customers can match the look and performance needed for each site.',
  },
  {
    id: '3',
    question: 'Do you serve projects outside Malappuram?',
    answer:
      'Yes. We work with residential and commercial customers across Kerala and coordinate supply based on the project location and order size.',
  },
  {
    id: '4',
    question: 'How do I choose the right interlock or tile design?',
    answer:
      'Our team helps you compare pattern, finish, application, and durability so you can select products that fit the space, traffic level, and overall design style.',
  },
  {
    id: '5',
    question: 'How can I request pricing or place an order?',
    answer:
      `You can contact ${companyInfo.name} by phone, WhatsApp, or email to discuss your requirement, get product guidance, and receive pricing based on quantity and delivery location.`,
  },
];
---

<div class="testimonial-area-4 overflow-hidden space bg-smoke" data-bg-src="/assets/img/bg/testimonial-bg4-1.png">
  <div class="container">
    <div class="row gx-100 gy-60 flex-row-reverse">
      <div class="col-xl-6">
        <div class="title-area">
          <span class="sub-title text-theme">Testimonials <i class="ri-arrow-right-down-line"></i></span>
          <h2 class="sec-title">Trusted by homeowners, builders, and project teams across Kerala</h2>
        </div>
        <div class="row global-carousel testi-slider1" data-slide-show="1">
          {
            testimonials.map((item) => (
              <div class="col-lg-6">
                <div class="testi-card">
                  <div class="quote-icon">
                    <img src="/assets/img/icon/quote.svg" alt="Quote icon" />
                  </div>
                  <div class="testi-card-thumb">
                    <img src={item.image} alt={item.name} />
                  </div>
                  <div class="testi-card_content">
                    <h4 class="testi-card_title">{item.title}</h4>
                    <p class="testi-card_text">{item.text}</p>
                    <div class="testi-card-profile">
                      <h4 class="testi-profile-title">{item.name}</h4>
                      <span class="testi-profile-desig">{item.role}</span>
                    </div>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
        <div class="btn-wrap mt-70">
          <div class="icon-box">
            <button data-slick-prev=".testi-slider1" class="slick-arrow style2 default">
              <i class="ri-arrow-left-down-line"></i>
            </button>
            <button data-slick-next=".testi-slider1" class="slick-arrow style2 default">
              <i class="ri-arrow-right-up-line"></i>
            </button>
          </div>

          <div class="testi-counter-wrap">
            <h3 class="testi-counter-number"><span class="counter-number">5.6</span>k+</h3>
            <p class="testi-counter-text">Satisfied clients across Kerala</p>
          </div>
        </div>
      </div>
      <div class="col-xl-6">
        <div class="accordion-area style2 accordion" id="faqAccordion">
          {
            faqs.map((faq) => (
              <div class:list={['accordion-card', faq.active && 'active']}>
                <div class="accordion-header" id={`collapse-item-${faq.id}`}>
                  <button
                    class:list={['accordion-button', !faq.active && 'collapsed']}
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target={`#collapse-${faq.id}`}
                    aria-expanded={faq.active ? 'true' : 'false'}
                    aria-controls={`collapse-${faq.id}`}>
                    {faq.question}
                  </button>
                </div>
                <div
                  id={`collapse-${faq.id}`}
                  class:list={['accordion-collapse collapse', faq.active && 'show']}
                  aria-labelledby={`collapse-item-${faq.id}`}
                  data-bs-parent="#faqAccordion">
                  <div class="accordion-body">
                    <p class="faq-text">{faq.answer}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>
