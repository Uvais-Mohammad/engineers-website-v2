---
import SiteImage from '../SiteImage.astro';
---

<div class="why-area-4 space overflow-hidden" data-bg-src="/assets/img/bg/why-bg4-1.png">
  <div class="container">
    <div class="row">
      <div class="col-xxl-5 col-lg-6">
        <div class="title-area">
          <span class="sub-title text-theme">Why should you choose us <i class="ri-arrow-right-down-line"></i></span>
          <h2 class="sec-title text-white">Reliable products built for lasting outdoor spaces</h2>
        </div>
      </div>
      <div class="col-xxl-4 offset-xxl-2 col-lg-6">
        <div class="wcu-card-wrap4 m-0">
          <div class="wcu-card">
            <div class="wcu-card-icon">
              <SiteImage src="/assets/img/icon/why-icon1-5.svg" alt="img" />
            </div>
            <div class="wcu-card-details">
              <h4 class="wcu-card-title text-white">Skilled Team</h4>
              <p class="wcu-card-text">Our team supports customers with practical product guidance, dependable service, and consistent delivery standards.</p>
            </div>
          </div>
          <div class="wcu-card">
            <div class="wcu-card-icon">
              <SiteImage src="/assets/img/icon/why-icon1-2.svg" alt="img" />
            </div>
            <div class="wcu-card-details">
              <h4 class="wcu-card-title text-white">Own Manufacturing</h4>
              <p class="wcu-card-text">In-house production helps us maintain quality across interlocks, designer tiles, and hollow bricks for every order.</p>
            </div>
          </div>
          <div class="wcu-card">
            <div class="wcu-card-icon">
              <SiteImage src="/assets/img/icon/why-icon1-6.svg" alt="img" />
            </div>
            <div class="wcu-card-details">
              <h4 class="wcu-card-title text-white">Strong Value</h4>
              <p class="wcu-card-text">Our products are built to balance durability, clean finishing, and long-term value for residential and commercial use.</p>
            </div>
          </div>
          <div class="wcu-card">
            <div class="wcu-card-icon">
              <SiteImage src="/assets/img/icon/why-icon1-1.svg" alt="img" />
            </div>
            <div class="wcu-card-details">
              <h4 class="wcu-card-title text-white">Design Variety</h4>
              <p class="wcu-card-text">We offer patterns, textures, and finishes that help transform everyday spaces into attractive outdoor environments.</p>
            </div>
          </div>
          <div class="wcu-card">
            <div class="wcu-card-icon">
              <SiteImage src="/assets/img/icon/why-icon1-3.svg" alt="img" />
            </div>
            <div class="wcu-card-details">
              <h4 class="wcu-card-title text-white">Kerala-wide Reach</h4>
              <p class="wcu-card-text">We supply dependable paving and construction products for homes, landscapes, and projects across Kerala.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="video-area-2 position-relative">
  <div class="video_thumb2-1" data-bg-src="/assets/img/normal/interlock-design.png"></div>
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <div class="video-wrap2" data-bg-src="/assets/img/bg/video-bg2-1.png">
          <a
            href="https://www.youtube.com/watch?v=Mp8IXI1kzvQ"
            class="popup-video play-btn-wrap style2 justify-content-end text-end">
            <div class="video-text">
              See our product story
            </div>
            <span class="play-btn style8">
              <i class="ri-play-fill"></i>
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
