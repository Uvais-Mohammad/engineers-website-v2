---
import fs from 'node:fs';
import path from 'node:path';

const projectDir = path.join(process.cwd(), 'public/assets/img/project');
const imageExtensions = new Set(['.png', '.jpg', '.jpeg', '.webp', '.avif']);

const toTitleCase = (value) =>
  value
    .split(/\s+/)
    .filter(Boolean)
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');

const projects = fs
  .readdirSync(projectDir)
  .filter((file) => imageExtensions.has(path.extname(file).toLowerCase()))
  .filter((file) => !/^project/i.test(path.parse(file).name))
  .sort((a, b) => a.localeCompare(b))
  .map((file, index) => {
    const slug = path.parse(file).name;

    return {
      number: `N.${String(index + 1).padStart(2, '0')}`,
      title: toTitleCase(slug.replace(/[-_]+/g, ' ')),
      address: 'MG Road, Kochi, Kerala',
      src: `/assets/img/project/${file}`,
      alt: toTitleCase(slug.replace(/[-_]+/g, ' ')),
    };
  });
---

<div class="bg-shape" data-bg-src="/assets/img/bg/project-bg4-1.png">
  <div class="portfolio-area-4 space-top">
    <div class="container">
      <div class="row justify-content-between align-items-center">
        <div class="col-lg-7">
          <div class="title-area text-lg-start text-center">
            <span class="sub-title text-theme">Recent Projects <i class="ri-arrow-right-down-line"></i></span>
            <h2 class="sec-title">Our recent interlock projects across Kerala</h2>
          </div>
        </div>
        <div class="col-lg-auto">
          <div class="sec-btn">
            <div class="icon-box">
              <button data-slick-prev=".portfolio-slider4" class="slick-arrow default style2">
                <i class="ri-arrow-left-line"></i>
              </button>
              <button data-slick-next=".portfolio-slider4" class="slick-arrow default style2">
                <i class="ri-arrow-right-line"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
      <div class="overflow-hidden">
        <div
          class="row gy-30 gx-30 global-carousel portfolio-slider4"
          data-slide-show="3"
          data-ml-slide-show="2"
          data-lg-slide-show="2"
          data-md-slide-show="2">
          {
            projects.map((project) => (
              <div class="col-lg-4">
                <div class="portfolio-card style4 recent-project-card">
                  <div class="portfolio-card-thumb">
                    <img src={project.src} alt={project.alt} />
                    <span class="portfolio-card-number">{project.number}</span>
                  </div>
                  <div class="portfolio-card-details">
                    <h4 class="portfolio-card-title">{project.title}</h4>
                    <p class="portfolio-card-address">{project.address}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div class="counter-area-1 space">
    <div class="container">
      <div class="row justify-content-between gy-40">
        <div class="col-auto">
          <div class="counter-card">
            <h2 class="counter-card_number"><span class="counter-number">10</span>k+</h2>
            <p class="counter-card_text">Projects Completed</p>
          </div>
        </div>
        <div class="col-auto">
          <div class="counter-card">
            <h2 class="counter-card_number"><span class="counter-number">98</span>%</h2>
            <p class="counter-card_text">Customers Satisfied</p>
          </div>
        </div>

        <div class="col-auto">
          <div class="counter-card">
            <h2 class="counter-card_number"><span class="counter-number">12</span>+</h2>
            <p class="counter-card_text">Years in Business</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .recent-project-card {
    height: 470px;
    padding-bottom: 0;
  }

  .recent-project-card .portfolio-card-thumb {
    height: 100%;
    overflow: hidden;
  }

  .recent-project-card .portfolio-card-thumb img {
    height: 100%;
    object-fit: cover;
  }

  .recent-project-card .portfolio-card-details {
    left: 20px;
    bottom: 20px;
    top: auto;
    transform: none;
    opacity: 1;
    visibility: visible;
    width: auto;
    max-width: calc(100% - 40px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .recent-project-card .portfolio-card-title {
    display: flex;
    align-items: center;
    color: var(--title-color);
    padding: 16px 22px;
    font-size: 22px;
    line-height: 1.3;
    margin: 0;
    width: 280px;
    min-height: 8px;
  }

  .recent-project-card .portfolio-card-address {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 10px 16px;
    background: #c62828;
    color: var(--white-color);
    font-size: 14px;
    line-height: 1.4;
    width: 280px;
    min-height: 8px;
  }

  .recent-project-card:hover .portfolio-card-details {
    transform: none;
  }

  @media (max-width: 991px) {
    .recent-project-card {
      height: 390px;
    }

    .recent-project-card .portfolio-card-thumb {
      height: 100%;
    }

    .recent-project-card .portfolio-card-title {
      font-size: 18px;
      width: 240px;
      min-height: 72px;
    }

    .recent-project-card .portfolio-card-address {
      width: 240px;
    }
  }
</style>
