---
import fs from 'node:fs';
import path from 'node:path';
import SiteImage from '../SiteImage.astro';

const clientDir = path.join(process.cwd(), 'public/assets/img/client');
const imageExtensions = new Set(['.png', '.jpg', '.jpeg', '.webp', '.avif', '.svg']);

const toLabel = (value) =>
  value
    .replace(/[-_]+/g, ' ')
    .split(/\s+/)
    .filter(Boolean)
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');

const clientLogos = fs
  .readdirSync(clientDir)
  .filter((file) => imageExtensions.has(path.extname(file).toLowerCase()))
  .filter((file) => !/^client-\d-/i.test(path.parse(file).name))
  .sort((a, b) => a.localeCompare(b))
  .map((file) => ({
    src: `/assets/img/client/${file}`,
    alt: toLabel(path.parse(file).name),
  }));

const sliderLogos = [...clientLogos, ...clientLogos];
---

<div class="client-area-4 bg-smoke" data-bg-src="/assets/img/bg/client-bg4-1.png">
  <div class="container">
    <div class="title-area text-center">
      <span class="sub-title text-theme">Our Clients <i class="ri-arrow-right-down-line"></i></span>
      <h2 class="sec-title">Our trusted partners</h2>
    </div>
    <div
      class="row global-carousel client-slider2 space text-center"
      data-slide-show="5"
      data-lg-slide-show="4"
      data-md-slide-show="3"
      data-sm-slide-show="3"
      data-xs-slide-show="3">
      {
        sliderLogos.map((logo) => (
          <div class="col-lg-auto">
            <div class="client-logo">
              <SiteImage src={logo.src} alt={logo.alt} />
            </div>
          </div>
        ))
      }
    </div>

    <!-- <div class="subscribe-area-4" data-bg-src="/assets/img/bg/subscribe-bg4-1.png">
      <div class="subscribe-thumb4-1">
        <SiteImage src="/assets/img/normal/subscribe_4-1.png" alt="img" />
      </div>
      <div class="subscribe-box">
        <h4 class="subscribe-box_title">Sign up to get the latest updates!</h4>
        <form class="newsletter-form">
          <input class="form-control" type="email" placeholder="Enter Your Email..." required />
          <button type="submit" class="btn style3">SUBCRIBE<i class="ri-arrow-right-up-line"></i></button>
        </form>
      </div>
    </div> -->
  </div>
</div>

<style>
  .client-area-4 .title-area {
    padding-top: 80px;
    margin-bottom: 24px;
  }

  .client-area-4 .client-logo {
    opacity: 1;
    transition: none;
  }

  .client-area-4 .client-slider2 .slick-slide {
    padding-inline: 10px;
  }

  .client-area-4 .client-logo:hover {
    opacity: 1;
  }

  .client-logo img {
    max-height: 120px;
    width: auto;
    max-width: 150px;
    object-fit: contain;
    margin: 0 auto;
  }

  @media (max-width: 767px) {
    .client-area-4 .client-slider2 .slick-slide {
      padding-inline: 6px;
    }

    .client-logo img {
      max-height: 76px;
      max-width: 175px;
    }
  }

  @media (max-width: 575px) {
    .client-logo img {
      max-height: 68px;
      max-width: 158px;
    }
  }
</style>
