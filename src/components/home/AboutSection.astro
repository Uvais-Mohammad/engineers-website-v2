---
import AboutTabs from './AboutTabs';
import { aboutSection } from '../../data/home';
---

<div class="about-area-4 space overflow-hidden">
  <div class="about-bg-shape4-1 shape-mockup" data-top="0">
    <img src="/assets/img/bg/about-bg-shape4-1.png" alt="" />
  </div>
  <div class="container">
    <div class="row gx-70 align-items-center flex-row-reverse">
      <div class="col-xl-6">
        <div class="about-thumb4 mb-40 mb-xl-0">
          <div class="about-img-1">
            <img src={aboutSection.imagePrimary} alt={aboutSection.title} />
          </div>
          <div class="about-img-2">
            <img src={aboutSection.imageSecondary} alt="Interlock detail" />
          </div>
          <div class="about-counter-wrap">
            <h3 class="about-counter-number">
              <span class="counter-number">{aboutSection.statValue}</span>{aboutSection.statSuffix}
            </h3>
            <p class="about-counter-text">{aboutSection.statText}</p>
          </div>
        </div>
      </div>
      <div class="col-xl-6">
        <div class="about-wrap4">
          <div class="title-area mb-40">
            <span class="sub-title text-theme">ABOUT US <i class="ri-arrow-right-down-line"></i></span>
            <h2 class="sec-title">{aboutSection.title}</h2>
            <p class="sec-text">{aboutSection.description}</p>
          </div>
          <AboutTabs items={aboutSection.tabs} client:load />
          <div class="row">
            {aboutSection.checklist.map((item) => (
              <div class="col-lg-6">
                <div class="checklist style7">
                  <ul>
                    <li><i class="ri-checkbox-circle-line"></i> {item}</li>
                  </ul>
                </div>
              </div>
            ))}
          </div>
          <div class="btn-group mt-50">
            <a href="/about/" class="btn">LEARN MORE <i class="ri-arrow-right-up-line"></i></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
