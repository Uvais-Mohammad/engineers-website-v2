---
interface Props {
  action?: string;
}

const { action = '#' } = Astro.props;
---

<form action={action} method="POST" class="contact-form ajax-contact" aria-label="Contact form">
  <div class="row gy-4">
    <div class="col-md-6">
      <div class="form-group">
        <input type="text" class="form-control" name="name" id="name" placeholder="Your Name" autocomplete="name" />
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-group">
        <input type="email" class="form-control" name="email" id="email" placeholder="Email Address" autocomplete="email" />
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-group">
        <input type="tel" class="form-control" name="number" id="number" placeholder="Phone Number" autocomplete="tel" />
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-group">
        <select name="subject" id="subject" class="single-select nice-select form-select" aria-label="Select subject">
          <option value="" disabled selected hidden>Select Subject</option>
          <option value="General Construction">General Construction</option>
          <option value="Property Maintenance">Property Maintenance</option>
          <option value="Project Management">Project Management</option>
          <option value="Virtual Design &amp; Build">Virtual Design &amp; Build</option>
        </select>
      </div>
    </div>
    <div class="col-12">
      <div class="form-group ">
        <textarea name="message" id="message" cols="30" rows="3" class="form-control" placeholder="Message..." autocomplete="off"></textarea>
      </div>
    </div>
    <div class="form-btn col-12">
      <button class="btn style2">Submit Message <i class="ri-arrow-right-up-line"></i></button>
    </div>
  </div>
  <p class="form-messages mb-0 mt-3"></p>
</form>
