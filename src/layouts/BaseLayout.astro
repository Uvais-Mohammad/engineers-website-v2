---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SiteChrome from '../components/SiteChrome.astro';
import { companyInfo, localBusinessSchema } from '../data/company';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  image = companyInfo.socialImage,
  noindex = false,
  schema,
} = Astro.props;

const canonicalUrl = new URL(canonical, Astro.site);
const imageUrl = new URL(image, Astro.site);
const whatsappNumber = companyInfo.whatsapp.replace(/\D/g, '');
const whatsappMessage = encodeURIComponent(`Hello ${companyInfo.name}, I would like to know more about your products.`);
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonicalUrl.href,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/png" sizes="32x32" href={companyInfo.favicon} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={companyInfo.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:alt" content={companyInfo.socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.href} />
    <meta name="twitter:image:alt" content={companyInfo.socialImageAlt} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com/" />
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&family=Titillium+Web:ital,wght@0,200;0,300;0,400;0,600;0,700;0,900;1,200;1,300;1,400;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/assets/fonts/remixicon.css" />
    <link rel="stylesheet" href="/assets/css/magnific-popup.min.css" />
    <link rel="stylesheet" href="/assets/css/slick.min.css" />
    <link rel="stylesheet" href="/assets/css/nice-select.min.css" />
    <link rel="stylesheet" href="/assets/css/style.css" />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <SiteChrome />
    <Header />
    <slot />
    <Footer />
    <a
      class="whatsapp-float"
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Chat with ${companyInfo.name} on WhatsApp`}
    >
      <span class="whatsapp-float__pulse" aria-hidden="true"></span>
      <i class="ri-whatsapp-line" aria-hidden="true"></i>
      <span class="whatsapp-float__label">Chat with us</span>
    </a>
    <div class="scroll-top">
      <svg class="progress-circle svg-content" width="100%" height="100%" viewBox="-1 -1 102 102">
        <path d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98"></path>
      </svg>
    </div>
    <script is:inline src="/assets/js/vendor/jquery-3.6.0.min.js"></script>
    <script is:inline src="/assets/js/slick.min.js"></script>
    <script is:inline src="/assets/js/jquery-ui.min.js"></script>
    <script is:inline src="/assets/js/bootstrap.min.js"></script>
    <script is:inline src="/assets/js/jquery.magnific-popup.min.js"></script>
    <script is:inline src="/assets/js/jquery.counterup.min.js"></script>
    <script is:inline src="/assets/js/jquery.marquee.min.js"></script>
    <script is:inline src="/assets/js/imagesloaded.pkgd.min.js"></script>
    <script is:inline src="/assets/js/isotope.pkgd.min.js"></script>
    <script is:inline src="/assets/js/nice-select.min.js"></script>
    <script is:inline src="/assets/js/wow.min.js"></script>
    <script is:inline src="/assets/js/waypoints.min.js"></script>
    <script is:inline src="/assets/js/main.js"></script>
  </body>
</html>

<style is:global>
  .whatsapp-float {
    position: fixed;
    right: 28px;
    bottom: 100px;
    z-index: 9998;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 58px;
    padding: 0 18px;
    border: 2px solid rgba(255, 255, 255, 0.9);
    border-radius: 999px;
    background: linear-gradient(135deg, #25d366, #128c4a);
    box-shadow: 0 10px 28px rgba(18, 140, 74, 0.35);
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    isolation: isolate;
  }

  .whatsapp-float:hover {
    color: #fff;
    transform: translateY(-5px) scale(1.03);
    box-shadow: 0 16px 36px rgba(18, 140, 74, 0.45);
  }

  .whatsapp-float i {
    font-size: 29px;
  }

  .whatsapp-float__pulse {
    position: absolute;
    inset: -2px;
    z-index: -1;
    border-radius: inherit;
    background: rgba(37, 211, 102, 0.45);
    animation: whatsapp-pulse 2.2s ease-out infinite;
  }

  @keyframes whatsapp-pulse {
    0% {
      opacity: 0.75;
      transform: scale(1);
    }
    75%,
    100% {
      opacity: 0;
      transform: scale(1.28);
    }
  }

  @media (max-width: 575px) {
    .whatsapp-float {
      right: 30px;
      bottom: 95px;
      width: 50px;
      min-height: 50px;
      padding: 0;
      justify-content: center;
    }

    .whatsapp-float i {
      font-size: 26px;
    }

    .whatsapp-float__label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-float,
    .whatsapp-float__pulse {
      animation: none;
      transition: none;
    }
  }
</style>
